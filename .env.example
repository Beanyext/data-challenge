# Образец настроек. Скопировать в .env и заполнить. Файл .env в git не попадает.

# Ключ Claude API для оценки моделью
ANTHROPIC_API_KEY=
# Адрес API организаторов из условия, вместе с подписью sig
CQA_API_URL=

# Необязательные
# CQA_MODEL=claude-opus-5-5
# CQA_EFFORT=high
# CQA_PROVIDER=anthropic        # mock — тестовый режим без модели
# CQA_WORKERS=4
# CQA_DB=outputs/server/cqa.sqlite3
# CQA_CORS_ORIGINS=http://127.0.0.1:8765
